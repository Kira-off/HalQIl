# -----------------------------------------------------------------------------
# HalQIl - Environment Variables Example
# Copy this file to '.env' or '.env.local' in the frontend directory and edit.
# -----------------------------------------------------------------------------

# Main REST API endpoint for fetching specialist catalogs, submitting applications, and managing orders.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# WebSocket Server endpoint for real-time notifications and instant order chat messaging.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Application brand name displayed throughout the header, titles, and layout panels.
NEXT_PUBLIC_APP_NAME=HalQIl
